# Keystore Properties Template for Android Release Signing
# Copy this file to 'keystore.properties' (or 'key.properties') inside the 'android' directory
# and replace the placeholders below with your release signing key parameters.
#
# IMPORTANT:
# - NEVER commit 'keystore.properties' or your keystore file (*.jks / *.keystore) into Git!
# - Ensure keystore.properties and *.jks remain in your .gitignore.

storeFile=release-keystore.jks
storePassword=your_keystore_password
keyAlias=your_key_alias
keyPassword=your_key_password
